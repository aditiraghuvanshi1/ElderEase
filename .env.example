# Copy to .env and export these (or set them in your host's dashboard). Nothing here is needed to run the demo.
PORT=3000
NODE_ENV=production
APP_URL=https://your-app.onrender.com        # used for links inside emails
DB_FILE=./server/data/elderease.db            # put this on a persistent disk in production
SEED_DEMO=1                                   # creates demo elder/caretaker/family accounts with 14 days of history

# Email: set ONE of these. With none, emails are written to the notification log only (dev mode),
# and when NODE_ENV is not production, password-reset links are printed to the server log.
RESEND_API_KEY=
SENDGRID_API_KEY=
# ...or any mail server over SMTP. Gmail: turn on 2-Step Verification, create an App Password,
# then SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ElderEase <reminders@yourdomain.com>

# Scheduler
TICK_SECONDS=60
DOSE_LEAD_MIN=15          # "upcoming dose" email this many minutes before
MISSED_GRACE_MIN=60       # a dose is "missed" this long after its time with no confirmation
DIGEST_DAILY_HOUR=20      # local hour for daily summaries
DIGEST_WEEKLY_HOUR=9      # local hour (Sundays) for weekly summaries
CRON_SECRET=              # lets an external cron (cron-job.org) call POST /api/cron/tick on hosts that sleep
TRUST_PROXY=1             # set when behind Render/Railway/Fly so rate limits see the real IP
